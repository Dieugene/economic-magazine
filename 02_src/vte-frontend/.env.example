# Режим работы с API
# mock  — встроенные тестовые данные, бэкенд не нужен (по умолчанию для локальной разработки)
# real  — реальный бэкенд (см. NEXT_PUBLIC_API_PROXY_TARGET ниже)
NEXT_PUBLIC_API_MODE=mock

# При работе с реальным бэкендом в dev-режиме укажите URL прокси.
# Фронт ходит на /backend/* своего origin, а Next.js API-route
# (src/app/backend/[...path]/route.ts) проксирует запрос на этот URL.
# Это решает проблемы с CORS на этапе локальной разработки.
# NEXT_PUBLIC_API_PROXY_TARGET=http://185.180.230.243/api

# Опционально: если задан, фронт обращается напрямую по этому URL
# вместо прокси через /backend. Полезно в production за reverse-proxy.
# NEXT_PUBLIC_API_URL=https://api.example.com
